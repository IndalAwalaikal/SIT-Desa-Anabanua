# =====================================================================
# Environment files — keep secrets & local overrides out of VCS
# =====================================================================
.env
.env.*
!.env.example

# =====================================================================
# Node.js / Frontend (Next.js 16)
# =====================================================================
Frontend/.eslintcache

# Local platform metadata
.vercel/
.railway/

# General Node tooling (covers stray root-level artifacts)
node_modules/
.next/
out/
build/
dist/
.cache/
coverage/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# =====================================================================
# Go Backend
# =====================================================================
Backend/bin/
Backend/tmp/
Backend/uploads/
Backend/api
Backend/api.exe
# database backup output (scripts/backup.sh)
Backend/backups/
Backend/.eslintcache
Backend/*.out
*.test
*.exe
coverage.out
*.cover
*.prof
*.pprof
go-build-cache/

# =====================================================================
# Python tooling (optional scripts/helpers)
# =====================================================================
__pycache__/
*.py[cod]
.venv/
venv/

# =====================================================================
# OS / Editor / IDE
# =====================================================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.iml
*.ipynb_checkpoints
*.~lock.*#

# =====================================================================
# Docker
# =====================================================================
docker-compose.override.yml

# =====================================================================
# Secrets & runtime artifacts
# =====================================================================
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
access.log*
error.log*

# =====================================================================
# Local uploads & generated media
# =====================================================================
uploads/
public/uploads/
media/
cache/

# =====================================================================
# Temp files & tooling caches
# =====================================================================
tmp/
temp/
*.tmp
.kilo/
.kilocode/
.Trash-*
.turbo
.pnpm-store

# Python tooling (whitepaper generator)
__pycache__/
*.pyc

# Backup migrasi lama (jangan di-commit)
Backend/migrations.bak*/
