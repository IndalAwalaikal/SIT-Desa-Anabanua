NEXT_PUBLIC_APP_NAME="Website Desa Anabanua"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Browser memanggil API melalui rewrite Next.js (same-origin).
NEXT_PUBLIC_API_BASE_URL=/api
# Hanya dipakai server Next.js dan rewrite. Di Vercel isi URL publik backend
# Railway (contoh https://api-production.up.railway.app); jangan expose ke browser.
API_INTERNAL_URL=http://localhost:8080
# Nomor WhatsApp resmi untuk tombol FloatingWhatsApp (format internasional tanpa +/spasi).
NEXT_PUBLIC_WHATSAPP_NUMBER=6285757106358
# Simulasi delay network (ms) untuk development debugging. Kosongkan/0 = non-aktif.
NEXT_PUBLIC_MOCK_DELAY_MS=0
