APP_ENV=development
APP_PORT=8080
# URL publik frontend; dipakai untuk tautan email seperti reset password.
APP_URL=http://localhost:3000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=desa_digital
DB_USER=desa_app
DB_PASSWORD=replace-with-a-strong-database-password
DB_ROOT_PASSWORD=replace-with-a-different-strong-root-password

JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
DOCUMENT_HMAC_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
VISITOR_HMAC_SECRET=replace-with-a-different-random-secret-of-at-least-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h


# Set only for the first boot of a new database, then remove these three values.
BOOTSTRAP_SUPER_ADMIN_NAME=
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

FILE_STORAGE_PATH=./uploads
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Isi dengan CIDR proxy reverse yang dipercaya untuk membaca X-Forwarded-For.
# Kosongkan bila backend menerima koneksi langsung saja.
# TRUSTED_PROXY_CIDRS=172.18.0.0/16
LOG_LEVEL=info

# Email otomatis (Sinch Mailjet). Kosongkan kredensial untuk mode NOOP (development):
# email hanya dicetak ke log termasuk kode OTP.
# MAILJET_API_KEY=
# MAILJET_API_SECRET=
# MAILJET_FROM_EMAIL=no-reply@desaanabanua.id

# Notifikasi WhatsApp (FlowKirim). Kosongkan FLOWKIRIM_API_KEY untuk mode NOOP
# (development): pesan hanya dicetak ke log. FLOWKIRIM_BASE_URL opsional.
# FLOWKIRIM_API_KEY=
# FLOWKIRIM_BASE_URL=

# Secret validasi header X-FlowKirim-Secret pada POST /webhook/whatsapp.
# Kosongkan hanya di development; WAJIB di-set di produksi.
# FLOWKIRIM_WEBHOOK_SECRET= # gunakan: openssl rand -hex 24
