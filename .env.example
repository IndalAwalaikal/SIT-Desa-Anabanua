# =====================================================================================
# Docker Local Deployment Environment — Template (hapus .env, pakai ini sebagai acuan)
# Salin ke .env dan isi nilai sebelum:  docker compose up --build -d
#
# Catatan: .env tidak boleh di-commit (berisi secrets). Lihat Backend/.env.example
# untuk variabel development Go lokal (DB_HOST=localhost).
# =====================================================================================

# --- MySQL ---
DB_NAME=desa_digital
DB_USER=desa_app
DB_PASSWORD= # isi password kuat
DB_ROOT_PASSWORD= # isi password root yang berbeda
MYSQL_DATA_DIR=/var/lib/mysql

# --- Backend (Go API) ---
APP_ENV=development
APP_PORT=8080
DB_HOST=mysql            # NAMA SERVICE Docker, selalu "mysql"
DB_PORT=3306
FILE_STORAGE_PATH=/app/uploads
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CIDR reverse proxy tepercaya; tanpa ini header X-Forwarded-For diabaikan.
# TRUSTED_PROXY_CIDRS=172.18.0.0/16
LOG_LEVEL=info
JWT_ACCESS_SECRET= # minimal 32 karakter, gunakan: openssl rand -base64 32
DOCUMENT_HMAC_SECRET= # minimal 32 karakter untuk TTD digital HMAC QR
VISITOR_HMAC_SECRET= # secret berbeda untuk HMAC alamat IP statistik pengunjung
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Bootstrap super admin (hanya untuk development — hapus di produksi)
BOOTSTRAP_SUPER_ADMIN_NAME=Super Admin Anabanua
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@desaanabanua.id
BOOTSTRAP_SUPER_ADMIN_PASSWORD= # minimal 12 karakter

# --- Email otomatis (Sinch Mailjet) ---
# Kosongkan untuk development → email hanya DICETAK di log backend (`docker compose logs -f backend`),
# termasuk kode OTP, sehingga verifikasi bisa dites tanpa SMTP. Isi untuk kirim email sungguhan.
# MAILJET_API_KEY=
# MAILJET_API_SECRET=
# MAILJET_FROM_EMAIL=no-reply@desaanabanua.id

# --- Notifikasi WhatsApp (FlowKirim) ---
# Kosongkan untuk development → pesan hanya DICETAK di log backend.
# Isi FLOWKIRIM_API_KEY untuk kirim WhatsApp sungguhan (daftar di https://flowkirim.com).
# FLOWKIRIM_BASE_URL boleh dikosongkan (default https://api.flowkirim.com).
# FLOWKIRIM_API_KEY=
# FLOWKIRIM_BASE_URL=
# Secret untuk validasi header X-FlowKirim-Secret pada POST /webhook/whatsapp.
# Kosongkan hanya di development; WAJIB di-set di produksi.
# FLOWKIRIM_WEBHOOK_SECRET= # gunakan: openssl rand -hex 24

# --- Frontend (Next.js) — variabel ini juga via ARG di Dockerfile build ---
NEXT_PUBLIC_APP_NAME="Website Desa Anabanua"
NEXT_PUBLIC_SITE_URL=http://localhost:3300
NEXT_PUBLIC_API_BASE_URL=/api
API_INTERNAL_URL=http://backend:8080
